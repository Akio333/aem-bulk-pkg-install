{
  "name": "aem-bulk-pkg-install",
  "displayName": "AEM Bulk Package Installer",
  "description": "Install AEM packages/bundles, and create, build, or replicate custom AEM content packages directly from JCR paths selected in the editor.",
  "version": "1.1.0",
  "publisher": "Akio333",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/akio333/aem-bulk-pkg-install"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:aem-bulk-installer.upload",
    "onCommand:aem-bulk-installer.install",
    "onCommand:aem-bulk-installer.backup",
    "onCommand:aem-bulk-installer.replicate",
    "onCommand:aem-bulk-installer.install-replicate",
    "onCommand:aem-bulk-installer.create-package",
    "onCommand:aem-bulk-installer.create-build-package",
    "onCommand:aem-bulk-installer.create-build-replicate-package"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "AEM Bulk Installer",
      "properties": {
        "aemBulkInstaller.environments": {
          "type": "array",
          "description": "Configure AEM environments (Author & Publisher).",
          "default": [
            {
              "name": "local",
              "isProd": false,
              "author": {
                "url": "http://localhost",
                "port": "4502",
                "username": "admin",
                "password": "admin"
              }
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Environment name (e.g. local, dev, stage, prod)."
              },
              "isProd": {
                "type": "boolean",
                "default": false,
                "description": "Mark this environment as a production environment to require confirmation before running actions."
              },
              "author": {
                "type": "object",
                "description": "AEM Author configuration",
                "properties": {
                  "url": {
                    "type": "string",
                    "default": "http://localhost",
                    "description": "Author instance URL"
                  },
                  "port": {
                    "type": "string",
                    "default": "4502",
                    "description": "Author instance port"
                  },
                  "username": {
                    "type": "string",
                    "default": "admin",
                    "description": "Author instance username"
                  },
                  "password": {
                    "type": "string",
                    "default": "admin",
                    "description": "Author instance password"
                  }
                }
              }
            }
          }
        }
      }
    },
    "commands": [
      {
        "command": "aem-bulk-installer.upload",
        "title": "AEM: Upload file(s)"
      },
      {
        "command": "aem-bulk-installer.install",
        "title": "AEM: Install file(s)"
      },
      {
        "command": "aem-bulk-installer.backup",
        "title": "AEM: Backup package(s)"
      },
      {
        "command": "aem-bulk-installer.replicate",
        "title": "AEM: Replicate file(s)"
      },
      {
        "command": "aem-bulk-installer.install-replicate",
        "title": "AEM: Install + Replicate file(s)"
      },
      {
        "command": "aem-bulk-installer.create-package",
        "title": "AEM: Create Package"
      },
      {
        "command": "aem-bulk-installer.create-build-package",
        "title": "AEM: Create + Build Package"
      },
      {
        "command": "aem-bulk-installer.create-build-replicate-package",
        "title": "AEM: Create + Build + Replicate Package"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "aem-bulk-installer.upload",
          "when": "resourceExtname == .zip || resourceExtname == .jar",
          "group": "aem@1"
        },
        {
          "command": "aem-bulk-installer.install",
          "when": "resourceExtname == .zip || resourceExtname == .jar",
          "group": "aem@2"
        },
        {
          "command": "aem-bulk-installer.backup",
          "when": "resourceExtname == .zip",
          "group": "aem@3"
        },
        {
          "command": "aem-bulk-installer.replicate",
          "when": "resourceExtname == .zip || resourceExtname == .jar",
          "group": "aem@4"
        },
        {
          "command": "aem-bulk-installer.install-replicate",
          "when": "resourceExtname == .zip || resourceExtname == .jar",
          "group": "aem@5"
        }
      ],
      "editor/context": [
        {
          "command": "aem-bulk-installer.create-package",
          "when": "editorHasSelection",
          "group": "aem-create@1"
        },
        {
          "command": "aem-bulk-installer.create-build-package",
          "when": "editorHasSelection",
          "group": "aem-create@2"
        },
        {
          "command": "aem-bulk-installer.create-build-replicate-package",
          "when": "editorHasSelection",
          "group": "aem-create@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-minify",
    "compile": "npm run esbuild",
    "watch": "npm run esbuild-watch",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-minify": "npm run esbuild-base -- --minify",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "@types/adm-zip": "^0.5.0",
    "@types/axios": "^0.14.0",
    "@types/form-data": "^2.5.0",
    "adm-zip": "^0.5.10",
    "axios": "^1.4.0",
    "form-data": "^4.0.0"
  }
}
